#! /usr/bin/env python3

import sys
import os
import argparse

this_script = os.path.realpath(__file__)
this_script_path = os.path.dirname(this_script)

parser = argparse.ArgumentParser()
parser.add_argument('--with-arch=', type=str, nargs=1,
                    help='Path to target C compiler.')
parser.add_argument('--with-abi=', type=str, nargs=1,
                    help='Path to target C++ compiler.')
parser.add_argument('--with-libc=', type=str, nargs=1,
                    help='Set the default libc.')
parser.add_argument('--with-ld=', type=str, nargs=1,
                    help='Set the default linker.')
parser.add_argument('--with-sysroot=', type=str, nargs=1,
                    help='What target triplet you want to test.')
parser.add_argument('--target=', type=str, nargs=1,
                    help='Path to target C compiler.')
parser.add_argument('--prefix=', type=str, nargs=1,
                    help='Host C compiler.')
parser.add_argument('--with-host-cxx=', type=str, nargs=1,
                    help='Host C++ compiler.')
parser.add_argument('--with-multilib-list=', type=str, nargs=1,
                    help='multi-lib list.')
parser.add_argument('--with-extra-flags=', type=str, nargs=1,
                    help='Set extra flags')
parser.add_argument('--compiler-wrapper=', type=str, nargs=1,
                    help='Specify to wrapper which compiler')

if (len(sys.argv) == 1):
    parser.print_help()

args = parser.parse_args(sys.argv[1:])

config_log = open("config.log", "w")

config_log.write("Configure options:\n")
config_log.write("%s\n" % " ".join(["\"%s\"" % x for x in sys.argv]))

v = vars(args)
error = False

def find_prog(prog):
    if prog is None:
        return None

    if os.path.sep in prog:
        if os.path.exists(prog):
            return prog
        else:
            return None
    else:
        paths = os.environ['PATH'].split(':')
        for path in paths:
            p = os.path.join(path, prog)
            if os.path.exists(p):
                return p
        return None

# Check options:

for key, val in v.items():
    print(key, val)
    if key == 'with_host_cxx=':
        if val is None:
            p = find_prog('c++')
        else:
            p = find_prog(v[key][0])

        if p is None:
            print(("`%s` not found!" % val))

        v[key] = p
    else:
        if val is None:
            v[key] = ''
        else:
            v[key] = v[key][0]

config_log.write("\nVars:\n")
config_log.write("\n".join(["%s%s"% x for x in iter(v.items())]))
config_log.write("\n")


if error:
    parser.print_help()
    sys.exit(1)

def subst_file(fin, fout, replace_vars):
    with open(fin, 'r') as file :
        filedata = file.read()

    # Replace the target string
    for key, val in replace_vars.items():
        filedata = filedata.replace('@%s@' % key, val)

    # Write the file out again
    with open(fout, 'w') as file:
        file.write(filedata)

replace_vars = dict()
replace_vars['ARCH'] = v['with_arch=']
replace_vars['ABI'] = v['with_abi=']
replace_vars['LIBC'] = v['with_libc=']
replace_vars['LD'] = v['with_ld=']
replace_vars['TARGET'] = v['target=']
replace_vars['PREFIX'] = v['prefix=']
replace_vars['SRCDIR'] = this_script_path
replace_vars['CXX'] = v['with_host_cxx=']
replace_vars['MULTI_LIB_LIST'] = v['with_multilib_list=']
replace_vars['EXTRA_FLAGS'] = v['with_extra_flags=']
mingw_prefix = 'mingw-'
if v['compiler_wrapper='].startswith(mingw_prefix):
    replace_vars['COMPILER_WRAPPER'] = v['compiler_wrapper='][len(mingw_prefix):]
    replace_vars['EXEEXT'] = '.exe'
else:
    replace_vars['COMPILER_WRAPPER'] = v['compiler_wrapper=']
    replace_vars['EXEEXT'] = ''

# Compute relative path between sysroot and prefix
bin_path = os.path.join(v['prefix='], "bin")
if v['with_sysroot=']:
    rel_sysroot = os.path.relpath(v['with_sysroot='], bin_path)
    replace_vars['REL_SYSROOT'] = rel_sysroot
else:
    replace_vars['REL_SYSROOT'] = '../sysroot'

subst_file(os.path.join(this_script_path, 'config.h.in'),
           os.path.join(os.getcwd(), 'config.h'),
           replace_vars)

subst_file(os.path.join(this_script_path, 'Makefile.in'),
           os.path.join(os.getcwd(), 'Makefile'),
           replace_vars)
