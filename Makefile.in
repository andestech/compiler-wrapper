SRCDIR := @SRCDIR@
PREFIX := @PREFIX@
TARGET := @TARGET@
CXX := @CXX@
CXXFLAGS := -O3 -I.
SRC := $(SRCDIR)/wrapper.cpp
COMPILER_WRAPPER := @COMPILER_WRAPPER@

ifeq ($(COMPILER_WRAPPER), gcc-wrapper)
PROG := $(addprefix $(TARGET)-,gcc g++ c++)
else ifeq ($(COMPILER_WRAPPER), clang-wrapper)
PROG := $(addprefix $(TARGET)-,clang clang++)
else ifeq ($(COMPILER_WRAPPER), clang-wrapper)
$(error "COMPILER_WRAPPER must be specified")
endif

all: $(PROG)

install: $(PROG)
	mkdir -p $(PREFIX)/bin
	cp $(PROG) $(PREFIX)/bin

clean:
	rm -f $(PROG)

distclean: clean
	rm config.log Makefile

%-clang: $(SRC)
	$(CXX) $(CXXFLAGS) -o $@ $< -DCLANGXX=0

%-clang++: $(SRC)
	$(CXX) $(CXXFLAGS) -o $@ $< -DCLANGXX=1

%-gcc: $(SRC)
	$(CXX) $(CXXFLAGS) -o $@ $< -DGXX=0

%-g++: $(SRC)
	$(CXX) $(CXXFLAGS) -o $@ $< -DGXX=1

%-c++: $(SRC)
	$(CXX) $(CXXFLAGS) -o $@ $< -DGXX=1
