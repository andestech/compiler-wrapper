SRCDIR := @SRCDIR@
PREFIX := @PREFIX@
TARGET := @TARGET@
EXEEXT := @EXEEXT@
CXX := @CXX@
CXXFLAGS := -O3 -I.
LIBIBERTY_INCLUDE := @LIBIBERTY_INCLUDE@
ifneq ($(LIBIBERTY_INCLUDE), )
  CXXFLAGS += -I$(LIBIBERTY_INCLUDE)
endif
LIBIBERTY_A := @LIBIBERTY_A@

OS := $(shell uname)
ifeq ($(OS), Darwin)
  LDFLAGS := $(LIBIBERTY_A)
else
  LDFLAGS := $(LIBIBERTY_A) -static
endif

SRC := $(SRCDIR)/wrapper.cpp
OBJS := path.o

COMPILER_WRAPPER := @COMPILER_WRAPPER@

ifeq ($(COMPILER_WRAPPER), gcc-wrapper)
PROG := $(addsuffix $(EXEEXT), $(addprefix $(TARGET)-,gcc g++ c++))
else ifeq ($(COMPILER_WRAPPER), clang-wrapper)
PROG := $(addsuffix $(EXEEXT), $(addprefix $(TARGET)-,clang clang++))
else
$(error "COMPILER_WRAPPER must be specified")
endif

all: $(PROG)

install: $(PROG)
	mkdir -p $(PREFIX)/bin
	cp $(PROG) $(PREFIX)/bin

clean:
	rm -f $(PROG)

distclean: clean
	rm config.log Makefile

%.o: $(SRCDIR)/%.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

%-clang$(EXEEXT): $(SRC) $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS) -DCLANGXX=0

%-clang++$(EXEEXT): $(SRC) $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS) -DCLANGXX=1

%-gcc$(EXEEXT): $(SRC) $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS) -DGXX=0

%-g++$(EXEEXT): $(SRC) $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS) -DGXX=1

%-c++$(EXEEXT): $(SRC) $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS) -DGXX=1
